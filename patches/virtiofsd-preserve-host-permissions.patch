+            uid: original.uid().into(),
+            gid: original.gid().into(),
+            pid: std::process::id() as i32,
+        };
+        let name = CStr::from_bytes_with_nul(b"existing\0").unwrap();
+        let entry = fs.lookup(ctx, fuse::ROOT_ID, name).unwrap();
+        let requested = fuse::SetattrIn {
+            mode: 0,
+            uid: 12345u32.into(),
+            gid: 12345u32.into(),
+            size: 3,
+            ..Default::default()
+        };
+        fs.setattr(
+            ctx,
+            entry.inode,
+            requested,
+            None,
+            SetattrValid::MODE | SetattrValid::UID | SetattrValid::GID | SetattrValid::SIZE,
+        )
+        .unwrap();
+        let after = std::fs::metadata(&path).unwrap();
+        assert_eq!(after.mode() & 0o7777, 0o640);
+        assert_eq!(after.uid(), original.uid());
+        assert_eq!(after.gid(), original.gid());
+        assert_eq!(std::fs::read(&path).unwrap(), b"abc");
+        let acl = CStr::from_bytes_with_nul(b"system.posix_acl_access\0").unwrap();
+        assert_eq!(
+            fs.setxattr(ctx, entry.inode, acl, b"", 0, SetxattrFlags::empty())
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EPERM)
+        );
+        assert_eq!(
+            fs.removexattr(ctx, entry.inode, acl)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EPERM)
+        );
+        let new_name = CStr::from_bytes_with_nul(b"new\0").unwrap();
+        fs.create(
+            ctx,
+            fuse::ROOT_ID,
+            new_name,
+            0,
+            false,
+            libc::O_RDWR as u32,
+            0,
+            Extensions::default(),
+        )
+        .unwrap();
+        assert_eq!(
+            std::fs::metadata(root.join("new")).unwrap().mode() & 0o600,
+            0o600
+        );
+        let dir_name = CStr::from_bytes_with_nul(b"directory\0").unwrap();
+        fs.mkdir(ctx, fuse::ROOT_ID, dir_name, 0, 0, Extensions::default())
+            .unwrap();
+        assert_eq!(
+            std::fs::metadata(root.join("directory")).unwrap().mode() & 0o700,
+            0o700
+        );
+        drop(fs);
+        std::fs::remove_dir_all(&root).unwrap();
+    }
