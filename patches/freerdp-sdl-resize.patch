+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#pragma once
+
+#include <cstdint>
+
+/* SDL_SyncWindow dispatches platform events into SDL's queue without consuming
+ * the application's SDL events. Once it completes, events generated through
+ * that barrier acknowledge our server-driven operation; they are not new local
+ * user intent, even if another RAIL order has since changed the desired state.
+ * Per-window and timestamp-based: later user actions are not suppressed by an
+ * arbitrary timeout. SDL event timestamps and SDL_GetTicksNS use the same clock.
+ */
+class SdlRailStateEcho
+{
+  public:
+	void syncedThrough(uint64_t timestamp)
+	{
+		if (timestamp > _through)
+			_through = timestamp;
+	}
+	[[nodiscard]] bool contains(uint64_t timestamp) const
+	{
+		return timestamp != 0 && timestamp <= _through;
+	}
+
+  private:
+	uint64_t _through = 0;
+};
