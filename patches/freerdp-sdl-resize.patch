@@ -0,0 +1,127 @@
+/* SPDX-License-Identifier: Apache-2.0
+ * WinTide: same-user RemoteApp launch forwarding over the existing RAIL channel.
+ */
+#pragma once
+#include <freerdp/settings.h>
+#include <freerdp/client/rail.h>
+#include <array>
+#include <string>
+#include <cstdlib>
+#include <cstring>
+#if defined(__linux__)
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <poll.h>
+#include <chrono>
+#include <thread>
+#endif
+
+class SdlRailLaunch
+{
+ public:
+  static SdlRailLaunch& instance() { static SdlRailLaunch broker; return broker; }
+  /* 0: own/new connection, 1: forwarded successfully, -1: fail closed. */
+  int prepare(const rdpSettings* settings)
+  {
+#if defined(__linux__)
+    const char* enabled = std::getenv("WINTIDE_SESSION_REUSE");
+    if (!enabled || std::strcmp(enabled, "1") ||
+        !freerdp_settings_get_bool(settings, FreeRDP_RemoteApplicationMode)) return 0;
+    const char* runtime = std::getenv("XDG_RUNTIME_DIR");
+    struct stat st{};
+    if (!runtime || lstat(runtime, &st) || !S_ISDIR(st.st_mode) ||
+        st.st_uid != getuid() || (st.st_mode & 0077)) return -1;
+    auto str = [settings](auto key) { const auto p = freerdp_settings_get_string(settings,key); return std::string(p ? p : ""); };
+    identity = str(FreeRDP_ServerHostname) + '\n' + std::to_string(freerdp_settings_get_uint32(settings, FreeRDP_ServerPort)) + '\n' + str(FreeRDP_Username) + '\n' + str(FreeRDP_Domain);
+    uint64_t hash = 14695981039346656037ULL;
+    for (unsigned char c : identity) { hash ^= c; hash *= 1099511628211ULL; }
+    path = std::string(runtime) + "/wintide-rail-" + std::to_string(hash) + ".sock";
+    sockaddr_un addr{}; addr.sun_family = AF_UNIX;
+    if (path.size() >= sizeof(addr.sun_path)) return -1;
+    std::memcpy(addr.sun_path,path.c_str(),path.size()+1);
+    lockfd = open((path+".lock").c_str(),O_CREAT|O_RDWR|O_CLOEXEC|O_NOFOLLOW,0600);
+    if (lockfd < 0 || fstat(lockfd,&st) || !S_ISREG(st.st_mode) || st.st_uid != getuid() || (st.st_mode & 0077)) return -1;
+    if (flock(lockfd,LOCK_EX|LOCK_NB) == 0)
+    {
+      owner = true;
+      unlink(path.c_str());
+      listener = socket(AF_UNIX,SOCK_SEQPACKET|SOCK_CLOEXEC|SOCK_NONBLOCK,0);
+      if (listener < 0 || bind(listener,reinterpret_cast<sockaddr*>(&addr),sizeof(addr)) || chmod(path.c_str(),0600) || listen(listener,16)) return -1;
+      return 0;
+    }
+    if (errno != EWOULDBLOCK) return -1;
+    const std::string message = identity + '\0' + str(FreeRDP_RemoteApplicationProgram) + '\0' + str(FreeRDP_RemoteApplicationWorkingDir) + '\0' + str(FreeRDP_RemoteApplicationCmdLine) + '\0';
+    if (message.size() > 65536) return -1;
+    int fd = -1;
+    for (int i=0;i<100;i++)
+    {
+      fd = socket(AF_UNIX,SOCK_SEQPACKET|SOCK_CLOEXEC,0);
+      if (fd < 0) return -1;
+      if (!connect(fd,reinterpret_cast<sockaddr*>(&addr),sizeof(addr))) break;
+      close(fd); fd=-1;
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+    if (fd < 0) return -1;
+    const auto sent = send(fd,message.data(),message.size(),MSG_NOSIGNAL);
+    pollfd pfd{fd,POLLIN,0}; char reply=0;
+    const bool ok = sent == static_cast<ssize_t>(message.size()) && poll(&pfd,1,60000)>0 && recv(fd,&reply,1,0)==1 && reply==1;
+    close(fd);
+    return ok ? 1 : -1;
+#else
+    (void)settings; return 0;
+#endif
+  }
+  void pollLaunch(RailClientContext* rail)
+  {
+#if defined(__linux__)
+    if (listener < 0 || !rail) return;
+    const int fd = accept4(listener,nullptr,nullptr,SOCK_CLOEXEC|SOCK_NONBLOCK);
+    if (fd < 0) return;
+    ucred cred{}; socklen_t len=sizeof(cred);
+    char reply=0;
+    pollfd pfd{fd,POLLIN,0};
+    if (!getsockopt(fd,SOL_SOCKET,SO_PEERCRED,&cred,&len) && cred.uid==getuid() && poll(&pfd,1,100)>0)
+    {
+      std::array<char,65537> buffer{};
+      const auto size=recv(fd,buffer.data(),buffer.size(),MSG_TRUNC);
+      if (size>0 && size<=65536 && buffer[static_cast<size_t>(size)-1]=='\0')
+      {
+        std::array<std::string,4> fields; size_t pos=0; bool valid=true;
+        for (auto& field:fields)
+        {
+          if (pos>=static_cast<size_t>(size)) { valid=false; break; }
+          field=buffer.data()+pos; pos+=field.size()+1;
+        }
+        if (valid && pos==static_cast<size_t>(size) && fields[0]==identity && !fields[1].empty())
+        {
+          RAIL_EXEC_ORDER exec{};
+          exec.flags=RAIL_EXEC_FLAG_EXPAND_WORKING_DIRECTORY|RAIL_EXEC_FLAG_EXPAND_ARGUMENTS;
+          exec.RemoteApplicationProgram=fields[1].c_str();
+          exec.RemoteApplicationWorkingDir=fields[2].c_str();
+          exec.RemoteApplicationArguments=fields[3].c_str();
+          if (rail->ClientExecute(rail,&exec)==CHANNEL_RC_OK) reply=1;
+        }
+      }
+    }
+    (void)send(fd,&reply,1,MSG_NOSIGNAL); close(fd);
+#else
+    (void)rail;
+#endif
+  }
+  ~SdlRailLaunch()
+  {
+#if defined(__linux__)
+    if (listener>=0) close(listener);
+    if (owner) unlink(path.c_str());
+    if (lockfd>=0) close(lockfd);
+#endif
+  }
+ private:
+  std::string identity,path;
+  int lockfd=-1,listener=-1;
+  bool owner=false;
+};
