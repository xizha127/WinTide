+bool SdlRailWindow::requestWindowedRestore()
+{
+	std::unique_lock lock(_gfxLock);
+	if (_windowedRestorePending)
+		return false;
+	_windowedRestorePending = true;
+	/* Remembered startup maximization must not maximize the local tile. A
+	 * later click on the native maximize button acts on the local surface. */
+	_localMaximizeToggle = _mapped && (SDL_GetTicks() - _mappedAt > 3000);
+	return true;
+}
