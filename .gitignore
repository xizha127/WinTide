# Default-deny publishing: only reviewed source categories are trackable.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY.md
!/components.lock.json
!/setup.sh
!/docs/
!/examples/
!/patches/
!/guest/
!/tools/
!/tests/
!/licenses/
!/.github/
# Local configuration, secrets and generated state are excluded everywhere.
**/local*
**/*.local.*
**/.env*
**/*secret*
**/*credential*
**/*password*
**/*token*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.kdbx
**/*.conf
**/*.log
**/*.jsonl
**/*.bak
**/*.backup
**/*.before*
**/*.iso
**/*.img
**/*.qcow*
**/*.vhd*
**/*.vmdk
**/*.fd
**/*.bcd
**/BCD
**/*.reg
**/*.exe
**/*.dll
**/*.sys
**/*.cer
**/*.cat
**/*.zip
**/*.tar*
**/*.png
**/*.ppm
**/__pycache__/
**/*.pyc
**/.DS_Store
**/state/
**/backups/
**/build/
**/sources/
**/.cache/
